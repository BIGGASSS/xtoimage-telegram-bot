# Copy to .env locally, fill in privately, and never commit it.
# Create your bot with Telegram's official @BotFather.
TELEGRAM_BOT_TOKEN=
# Alternatively use TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# and add the corresponding read-only Docker/Compose secret mount.

# fxtwitter = no-key independent third-party public-post provider.
# x_api = official X API; needs your own access/credits and Bearer token.
POST_PROVIDER=fxtwitter
# X_BEARER_TOKEN=
# X_BEARER_TOKEN_FILE=/run/secrets/x_bearer_token

# Strongly recommended for a personal bot. Ask the bot /id to get your ID.
# Empty allows any Telegram user who discovers the bot to use it in private chats.
ALLOWED_USER_IDS=
PRIVATE_CHATS_ONLY=true
DEFAULT_THEME=light
# Internal renderer ceiling; polling intentionally processes one update at a time.
MAX_CONCURRENCY=2
USER_COOLDOWN_SECONDS=10

# Optional system Chromium override for native installs; omit in Docker.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
